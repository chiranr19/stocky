# Copy to backend/.env and fill in as needed. Never commit the real .env.

# Comma/JSON list of allowed frontend origins for CORS.
CORS_ORIGINS=["http://localhost:3000"]

# How long (seconds) cached market data is considered fresh before re-fetching.
CACHE_TTL_SECONDS=900

# On startup, warm the full S&P 500 universe in the background (priority tickers
# first). Set false for a faster boot when you only need the seeded watchlist.
WARM_ON_START=true

# Tickers per yfinance bulk download during warm-up.
INGEST_CHUNK_SIZE=100

# Benchmark everything is compared against.
BENCHMARK=VOO

# Used later by the Daily Brief job (v0.2). Leave empty for now.
ANTHROPIC_API_KEY=

# Followed Filers (v0.8): SEC EDGAR fair-access policy requires a descriptive
# User-Agent with real contact info on every request. Set your own name + email.
# Leave empty to disable insider-disclosure ingestion entirely.
EDGAR_USER_AGENT="Your Name your@email.com"
